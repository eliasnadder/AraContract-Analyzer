# AraContract Analyzer - Frontend .gitignore

# === Dependencies ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Build Output ===
dist/
build/
out/

# === React/Vite ===
.vite/
.parcel-cache/

# === Testing ===
coverage/
*.lcov
.nyc_output/

# === IDE ===
.idea/
.vscode/
*.swp
*.swo

# === Environment Variables ===
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# === OS Files ===
.DS_Store
Thumbs.db

# === Lockfiles (keep one, ignore the other) ===
# Uncomment based on your package manager:
# package-lock.json  # If using yarn
# yarn.lock          # If using npm

# === Temporary Files ===
*.tmp
*.bak