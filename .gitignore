# AraContract Analyzer - Root .gitignore

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# === Virtual Environments ===
# Keep backend/.venv/ ignored separately
venv/
ENV/
env/
.venv/

# === IDE ===
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# === Jupyter Notebooks ===
.ipynb_checkpoints/
*.ipynb_checkpoints

# === Model Checkpoints & Data ===
# Large binary files - store externally or in Git LFS
*.pt
*.pth
*.bin
*.onnx
*.h5
checkpoints/
models/checkpoints/

# === Logs ===
*.log
logs/

# === Environment Variables ===
.env
.env.local
.env.*.local
*.env

# === OS Files ===
.DS_Store
Thumbs.db
desktop.ini

# === Temporary Files ===
tmp/
temp/
*.tmp
*.bak

# === Codegraph ===
.codegraph/

# === Testing ===
.pytest_cache/
.coverage
htmlcov/
.tox/

# === Documentation ===
docs/_build/
site/